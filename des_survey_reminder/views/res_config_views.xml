<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_survey_feedback" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.survey.feedback</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="invite_users" position="after">

                <div class="app_settings_block" data-string="Survey Reminder FeedBack" data-key="survey_reminder">
                    <h2>Survey Feedback Reminder</h2>
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_right_pane">
                                    <field name="survey_feedback_reminder" class="oe_inline"/>
                                    <span aria-label="Survey Feedback Reminder"/>
                                    <span class="o_form_label">Days for Survey Feedback Reminder</span>
                                    <div class="text-muted">
                                        Configure the number of days between survey reminders
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
